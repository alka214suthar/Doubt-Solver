# Copy to `.env` and fill real values. Never commit `.env`.

APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Required in production
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/doubt_solver
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=generate-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Set true when the API is served over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated exact frontend origins allowed by CORS (never use *)
# Local development defaults if unset:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://your-project-domain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional override for uploaded files directory
UPLOAD_DIR=uploads

# Doubt history and uploaded-image retention period
DOUBT_RETENTION_DAYS=10

# Gemini reliability
GEMINI_MODEL=gemini-2.5-flash-lite
PROMPT_VERSION=v1
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=1

# Per-user rate limits for POST /api/v1/doubts/solve-doubt
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SOLVE_PER_MINUTE=10
RATE_LIMIT_SOLVE_PER_HOUR=60

# Duplicate-question answer cache (Postgres)
QUESTION_CACHE_ENABLED=true
QUESTION_CACHE_TTL_HOURS=168
